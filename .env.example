# TOTM Trust API base (no /api/v1). Used by the dev proxy (vite.config.ts) and the Vercel function (api/trust.js).
TRUST_API_URL=https://totmregistryapis-production.up.railway.app
# Admin key (SECRET). Server side only: added by the proxy, never sent to the browser. Never prefix it with VITE_.
ADMIN_API_KEY=

# Portal login (SECRET). The user types these on the sign-in screen; they are checked server side only.
PORTAL_USERNAME=
PORTAL_PASSWORD=
# Name shown in the portal and written to the audit log (defaults to the username)
PORTAL_DISPLAY_NAME=Tobi Santoso
# Signs the session cookie. Optional; any long random string. Changing it signs everyone out.
PORTAL_SESSION_SECRET=

# --- PILA verification (credentials NOT issued by TOTM). Runs pila-verifier/ (PILA's Go SDK + NDAKey). ---
# Where the pila-verifier runs (local: go run . in pila-verifier/, listens on 4100)
PILA_VERIFIER_URL=http://127.0.0.1:4100
# Shared secret between the portal proxy and the verifier (set it when the verifier is hosted)
PILA_VERIFIER_TOKEN=
# Read by pila-verifier: NDAKey verifier API key (SECRET) and URL
PILA_PARTNER_API_KEY=
PILA_NDAKEY_URL=https://api-beta.ndakey.vn/service/api/v1
